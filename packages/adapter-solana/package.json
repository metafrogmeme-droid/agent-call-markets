{
  "name": "@agent-call-markets/adapter-solana",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "ChainAdapter for the call_markets Anchor program on Solana devnet/localnet, plus a CLI. Refuses mainnet.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:svm": "vitest run --config vitest.svm.config.ts --coverage",
    "smoke:localnet": "node scripts/localnet-smoke.ts",
    "cli": "node src/cli/main.ts"
  },
  "dependencies": {
    "@agent-call-markets/core": "workspace:*",
    "@noble/hashes": "2.4.0",
    "@solana-program/system": "0.14.1",
    "@solana-program/token": "0.16.1",
    "@solana/kit": "8.6.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "litesvm": "1.6.2",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
